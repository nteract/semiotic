{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "paths": {
      "semiotic/network": ["../../src/components/semiotic-network.ts"],
      "semiotic/ordinal": ["../../src/components/semiotic-ordinal.ts"],
      "semiotic/artifact": ["../../src/components/semiotic-artifact.ts"],
      "semiotic/ai/core": ["../../src/components/semiotic-ai-core.ts"],
      "semiotic/server": ["../../src/components/semiotic-server.ts"],
      "semiotic/utils": ["../../src/components/semiotic-utils.ts"],
      "semiotic/themes/react": ["../../src/components/semiotic-themes-react.ts"]
    }
  },
  "include": [
    "../../docs/src/pages/examples/SuperpersuasionExamplePage.tsx",
    "../../docs/src/pages/examples/superpersuasion/**/*.ts",
    "../../docs/src/pages/examples/superpersuasion/**/*.tsx",
    "../../integration-tests/docs-examples-superpersuasion.spec.ts",
    "../../src/setupTests.ts"
  ],
  "exclude": []
}
